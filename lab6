gedit PigExample.pig

students = LOAD '/user/root/pigdata/students.txt' USING 
PigStorage(',') AS (id:int, name:chararray, dept:chararray, 
marks:int); 

high_scorers = FILTER students BY marks > 80; 

sorted_students = ORDER students BY marks DESC; 

projected = FOREACH students GENERATE name, marks; 

grouped = GROUP students BY dept;

average_marks = FOREACH grouped GENERATE group AS department, 
AVG(students.marks) AS avg_marks;

STORE sorted_students INTO '/user/root/pigoutput/sorted_students' USING PigStorage(','); 

STORE high_scorers INTO '/user/root/pigoutput/high_scorers' USING PigStorage(','); 

STORE projected INTO '/user/root/pigoutput/projected' USING PigStorage(','); 

STORE average_marks INTO '/user/root/pigoutput/average_marks' USING PigStorage(',');

hdfs dfs -mkdir /user/root/pigdata
hdfs dfs -copyFromLocal ~/Desktop/students.txt /user/root/pigdata
hdfs dfs -cat /user/root/pigdata/students.txt
pig -x mapreduce PigExample.pig
hdfs dfs -ls /user/root/pigoutput/sorted_students
hdfs dfs -cat /user/root/pigoutput/sorted_students/part-r-00000
hdfs dfs -cat /user/root/pigoutput/high_scorers/part-m-00000
hdfs dfs -cat /user/root/pigoutput/projected/part-m-00000
hdfs dfs -cat /user/root/pigoutput/average_marks/part-r-00000
