# 5. remove old output if exists
hdfs dfs -rm -r -f /output_wordCount

# 6. run the job
hadoop jar wordcount.jar WordCount /input_wordCount /output_wordCount

# 7. view results
hdfs dfs -cat /output_wordCount/part-r-00000


